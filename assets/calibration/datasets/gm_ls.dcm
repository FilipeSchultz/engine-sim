   ST/Y 50
   WERT    4.883    5.116    5.363    5.505    5.591    5.679    5.672    5.583    5.451    5.311    5.184    5.070    4.968    4.876    4.794    4.248
   ST/Y 60
   WERT    5.897    6.191    6.448    6.597    6.688    6.780    6.765    6.652    6.489    6.317    6.162    6.022    5.898    5.786    5.686    5.031
   ST/Y 70
   WERT    6.910    7.267    7.532    7.689    7.785    7.882    7.858    7.720    7.526    7.323    7.139    6.975    6.828    6.697    6.579    5.815
   ST/Y 80
   WERT    7.924    8.342    8.616    8.781    8.882    8.983    8.951    8.788    8.564    8.329    8.116    7.927    7.758    7.607    7.472    6.599
   ST/Y 90
   WERT    8.937    9.418    9.700    9.873    9.978   10.084   10.044    9.856    9.601    9.335    9.093    8.879    8.688    8.517    8.364    7.383
   ST/Y 100
