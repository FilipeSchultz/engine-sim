   ST/Y 50
   WERT    4.850    5.111    5.361    5.505    5.593    5.681    5.682    5.596    5.464    5.328    5.202    5.090    4.989    4.899    4.817    4.255
   ST/Y 60
   WERT    5.869    6.189    6.448    6.601    6.693    6.786    6.778    6.668    6.505    6.338    6.184    6.048    5.924    5.814    5.715    5.040
   ST/Y 70
   WERT    6.888    7.267    7.535    7.696    7.793    7.891    7.875    7.741    7.546    7.349    7.166    7.005    6.859    6.729    6.613    5.824
   ST/Y 80
   WERT    7.907    8.345    8.622    8.791    8.893    8.996    8.971    8.813    8.588    8.359    8.148    7.962    7.794    7.644    7.511    6.609
   ST/Y 90
   WERT    8.926    9.423    9.709    9.887    9.994   10.100   10.068    9.885    9.629    9.370    9.131    8.919    8.729    8.559    8.408    7.393
   ST/Y 100
   WERT    9.945   10.501   10.797   10.982   11.094   11.205   11.164   10.958   10.670   10.380   10.113    9.876    9.664    9.475    9.306    8.178
   ST/Y 105
   WERT   10.455   11.040   11.340   11.530   11.644   11.758   11.712   11.494   11.191   10.885   10.604   10.355   10.131    9.932    9.755    8.570
END

KENNFELD IgnAdvanceMap 16 12
   LANGNAME "Spark advance"
   EINHEIT_X "rpm"
   EINHEIT_Y "kPa"
   EINHEIT_W "deg"
   ST/X      500      750     1000     1250     1500     2000     2500     3000     3500     4000     4500     5000     5500     6000     6500     7000
   ST/Y 10
   WERT   12.000   12.000   12.014   14.000   16.027   20.001   24.996   29.999   35.000   39.978   40.000   40.000   40.000   40.000   40.000   40.000
   ST/Y 15
   WERT   12.000   12.000   12.013   14.000   16.026   20.001   24.996   29.999   35.000   39.979   40.000   40.000   40.000   40.000   40.000   40.000
   ST/Y 20
