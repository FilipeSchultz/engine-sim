   ST/Y 60
   WERT   12.000   12.000   12.005   14.000   16.010   20.000   24.999   30.000   35.000   39.993   40.000   40.000   40.000   40.000   40.000   40.000
   ST/Y 70
   WERT   12.000   12.000   12.004   14.000   16.006   20.000   24.999   30.000   35.000   39.996   40.000   40.000   40.000   40.000   40.000   40.000
   ST/Y 80
   WERT   12.000   12.000   12.002   14.000   16.002   20.000   24.999   30.000   35.000   39.999   40.000   40.000   40.000   40.000   40.000   40.000
   ST/Y 90
   WERT   12.000   12.000   12.000   14.000   15.999   19.999   25.000   30.000   35.000   40.003   40.000   40.000   40.000   40.000   40.000   40.000
   ST/Y 100
   WERT   12.000   12.000   11.998   14.000   15.995   19.999   25.000   30.000   35.000   40.006   40.000   40.000   40.000   40.000   40.000   40.000
   ST/Y 105
   WERT   12.000   12.000   11.998   14.000   15.994   19.999   25.001   30.000   35.000   40.007   40.000   40.000   40.000   40.000   40.000   40.000
END

FESTWERT CrankingRpm
   LANGNAME "Engine speed below which the engine is considered cranking"
   EINHEIT_W "rpm"
   WERT 400
END

FESTWERT CrankingFuelFactor
   LANGNAME "Injection time multiplier while cranking"
   EINHEIT_W "-"
   WERT 0.5
END

FESTWERT AfterStartTime
   LANGNAME "Time for the cranking factor to fade to 1 once the engine runs"
   EINHEIT_W "s"
   WERT 1.5
END
