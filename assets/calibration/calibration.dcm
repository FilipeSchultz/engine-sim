* engine-sim ECU calibration dataset
* Engine: GM LS V8 (assets/engines/atg-video-2/07_gm_ls.mr)
* Learned from the engine script behaviour (steady-state points, linear fit
* against MAP per RPM column): 16 fuel and 16 ignition RPM columns learned

KONSERVIERUNG_FORMAT 2.0

FESTWERT EcuFuelEnable
   LANGNAME "Fuel from FuelBaseMap (0 = engine script mixture)"
   EINHEIT_W "-"
   WERT 1
END

FESTWERT EcuIgnEnable
   LANGNAME "Spark advance from IgnAdvanceMap (0 = engine script curve)"
   EINHEIT_W "-"
   WERT 1
END

FESTWERT InjectorFlow
   LANGNAME "Injector static flow"
   EINHEIT_W "cc/min"
   WERT 630
END

FESTWERT InjectorDeadTime
   LANGNAME "Injector dead time"
   EINHEIT_W "ms"
   WERT 1
END

KENNFELD FuelBaseMap 16 12
   LANGNAME "Base injection time"
   EINHEIT_X "rpm"
   EINHEIT_Y "kPa"
   EINHEIT_W "ms"
   ST/X      500      750     1000     1250     1500     2000     2500     3000     3500     4000     4500     5000     5500     6000     6500     7000
   ST/Y 10
   WERT    0.774    0.800    1.012    1.124    1.191    1.262    1.296    1.306    1.298    1.285    1.273    1.262    1.250    1.239    1.227    1.117
   ST/Y 15
