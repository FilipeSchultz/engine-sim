private import "engine_sim.mr"

// Link to the ECU. The ECU is ecu-standalone (calibration, XCP, datalog); the
// simulator plays its I/O controller over UDP. Call it from the engine
// script's main node (or from main.mr) to change the defaults, e.g.
// set_ecu_settings(link_sync: "free"). Read when the simulator starts; the
// environment variables ENGINE_SIM_ECU_LINK_* override it.
public node set_ecu_settings => __engine_sim__set_ecu_settings {
    // Where ecu-standalone listens
    input link_address [string]: "127.0.0.1";
    input link_port [int]: 5600;

    // "lockstep": the simulation waits for the ECU's answer to each 10 ms
    // sample (deterministic results); "free": it never waits (latency and
    // losses as on a real bench)
    input link_sync [string]: "lockstep";
}
