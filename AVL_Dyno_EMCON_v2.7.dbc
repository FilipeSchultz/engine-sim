VAL_ 512 Torque_Mode_State 1 "Td_Mode Shaft Torque Controler" 0 "Te_Mode Normal Torque Controler" ;
VAL_ 512 Dyno_OnOff_State 2 "Transition" 1 "DynoON" 0 "DynoOFF" ;
VAL_ 512 System_Error 1 "NoTrouble" 0 "Trouble" ;
VAL_ 512 Control_Mode_State 1 "Torque" 0 "Speed" ;
VAL_ 512 System_State 2 "Remote" 1 "Manual" 0 "notManual" ;
VAL_ 256 Torque_Mode_Command 1 "Td_Mode Shaft Torque Controler" 0 "Te_Mode Normal Torque Controler" ;
VAL_ 256 Remote_Takeover 1 "Remote" 0 "Manual" ;
VAL_ 256 Reset_Key 1 "pushed" 0 "released" ;
VAL_ 256 Dyno_On_Off 1 "Dyno_ON" 0 "Dyno_OFF" ;
VAL_ 256 Control_Mode_Command 1 "Torque" 0 "Speed" ;
VAL_ 256 Remote_Command 1 "Remote" 0 "Manual" ;
VAL_ 256 Ignition_Key 1 "On" 0 "Off" ;
VAL_ 256 Starter 1 "Cranking" 0 "Off" ;
SIG_VALTYPE_ 529 Dyno_Speed : 1;
SIG_VALTYPE_ 529 Throttle_Set : 1;
SIG_VALTYPE_ 530 Dyno_Torque : 1;
SIG_VALTYPE_ 272 Speed_Demand : 1;
