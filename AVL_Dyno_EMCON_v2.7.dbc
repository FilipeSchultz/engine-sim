BS_ :

BU_ : BME HOST

BO_ 529 BME_Actual_1: 8 BME
  SG_ Dyno_Speed : 0|32@1+ (1,0) [-10000|10000] "rpm" Vector__XXX
  SG_ Throttle_Set : 32|32@1+ (1,0) [0|100] "%" Vector__XXX

BO_ 530 BME_Actual_2: 6 BME
  SG_ Dyno_Torque : 0|32@1+ (1,0) [-10000|10000] "Nm" Vector__XXX
  SG_ Lifesignal : 32|16@1+ (1,0) [0|10000] "" Vector__XXX

BO_ 512 BME_Control: 5 BME
  SG_ Control_Mode_State : 8|8@1+ (1,0) [0|255] "" Vector__XXX
  SG_ Dyno_OnOff_State : 24|8@1+ (1,0) [0|255] "-" Vector__XXX
  SG_ System_Error : 16|8@1+ (1,0) [0|255] "" Vector__XXX
  SG_ System_State : 0|8@1+ (1,0) [0|255] "" Vector__XXX
  SG_ Torque_Mode_State : 32|8@1+ (1,0) [0|255] "" Vector__XXX

BO_ 256 HOST_Control: 7 HOST
  SG_ Control_Mode_Command : 8|8@1+ (1,0) [0|255] "" Vector__XXX
  SG_ Dyno_On_Off : 16|8@1+ (1,0) [0|0] "" Vector__XXX
  SG_ Ignition_Key : 40|1@1+ (1,0) [0|1] "" Vector__XXX
  SG_ Remote_Command : 0|8@1+ (1,0) [0|255] "" Vector__XXX
  SG_ Remote_Takeover : 32|8@1+ (1,0) [0|255] "" Vector__XXX
  SG_ Reset_Key : 24|8@1+ (1,0) [0|0] "" Vector__XXX
  SG_ Starter : 41|1@1+ (1,0) [0|1] "" Vector__XXX
  SG_ Torque_Mode_Command : 48|8@1+ (1,0) [0|255] "" Vector__XXX

BO_ 272 HOST_Demand_1: 8 HOST
  SG_ Speed_Demand : 0|32@1+ (1,0) [-10000|10000] "rpm" Vector__XXX
  SG_ Torque_Demand : 32|32@1+ (1,0) [-10000|10000] "Nm" Vector__XXX

BO_ 273 HOST_Demand_2: 6 HOST
  SG_ Alpha_demand : 0|32@1+ (1,0) [0|100] "%" Vector__XXX
  SG_ LifesignalFeedback : 32|16@1+ (1,0) [0|10000] "-" Vector__XXX

CM_ BO_ 529 "BME->HOST";
CM_ BO_ 530 "BME->HOST";
CM_ BO_ 512 "BME->HOST";
CM_ BO_ 256 "HOST->BME";
CM_ BO_ 272 "HOST->BME";
CM_ BO_ 273 "HOST->BME";
CM_ SG_ 256 Reset_Key "needs pulse 0->1; then back to 0";
CM_ SG_ 256 Control_Mode_Command "0 = speed control (dyno follows Speed_Demand), 1 = torque control (dyno applies Torque_Demand)";
CM_ SG_ 256 Ignition_Key "Engine ignition (engine-sim extension, not part of AVL EMCON)";
CM_ SG_ 256 Starter "Starter motor, active while 1 (engine-sim extension, not part of AVL EMCON)";
CM_ SG_ 273 LifesignalFeedback "Echo of BME Lifesignal. BME sets System_Error = Trouble and leaves remote control if not updated for 100 ms (5 cycles)";
CM_ SG_ 530 Lifesignal "Incremented by the BME every cycle, wraps around";
CM_ SG_ 530 Dyno_Torque "Positive = braking (absorbed) torque";
BA_DEF_ "DBName" STRING;
BA_DEF_ "BusType" STRING;
BA_DEF_ BO_ "VFrameFormat" ENUM "StandardCAN","ExtendedCAN","reserved","J1939PG","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","StandardCAN_FD","ExtendedCAN_FD";
